modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
NOTIFY_EMAIL = "aae@turbobytetech.com"

[userenv.shared]
OBJECT_STORAGE_BUCKET = "turbobyte-private"
OBJECT_STORAGE_ENDPOINT = "https://tcymduyyzrgeowthzxgy.supabase.co/storage/v1/s3"
OBJECT_STORAGE_REGION = "ap-south-1"
SUPABASE_ANON_KEY = "sb_publishable_qfkG5sOek7K2HB9qgExWNQ_HY7ehrQU"
SUPABASE_URL = "https://tcymduyyzrgeowthzxgy.supabase.co"
VITE_SUPABASE_ANON_KEY = "sb_publishable_qfkG5sOek7K2HB9qgExWNQ_HY7ehrQU"
VITE_SUPABASE_URL = "https://tcymduyyzrgeowthzxgy.supabase.co"

[objectStorage]
defaultBucketID = "replit-objstore-a7ffac0e-d8f0-4bba-97ed-33d4d4d4235c"
