# ============================================================
# TurboByte Tech Solutions — Environment Variable Reference
# ============================================================
# Copy to .env and fill in real values. Never commit .env.
# Lines marked [SECRET] must be set via `wrangler secret put`
# (Workers) or the Cloudflare Pages dashboard (encrypted env)
# and must NEVER appear in source control.
# Lines marked [PUBLIC] are safe to bake into built assets or
# wrangler.toml [vars].
# ============================================================


# ── Runtime ─────────────────────────────────────────────────
# [PUBLIC] Node.js process mode. Set to "production" in prod.
NODE_ENV=development

# [PUBLIC] TCP port for local development. Defaults to 8080 for the API
# and 5173 for Vite when omitted.
PORT=8080


# ── Database (Supabase Postgres) ─────────────────────────────
# [SECRET] Full Postgres connection string from the Supabase
# dashboard → Project Settings → Database → Connection string.
# For Workers, use the transaction pooler URI with sslmode=require.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require


# ── Supabase Auth ────────────────────────────────────────────
# [PUBLIC] Supabase project URL. Safe to expose in browser JS.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co

# [PUBLIC] Supabase anon/public key. Safe to expose in browser JS.
# Row-Level Security enforces access control — never use the
# service_role key on the client side.
VITE_SUPABASE_ANON_KEY=eyJ...

# [PUBLIC] The API uses the same project URL and anon key to verify bearer
# tokens against Supabase Auth. Set these on the Worker.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...


# ── Object Storage (Supabase S3-compatible) ──────────────────
# Supabase Storage exposes an S3-compatible endpoint.
# Credentials are found in: Supabase dashboard →
#   Storage → Policies & Credentials (or Project Settings → S3).

# [SECRET] S3 access key ID for Supabase Storage.
OBJECT_STORAGE_ACCESS_KEY_ID=your-supabase-s3-access-key-id

# [SECRET] S3 secret access key for Supabase Storage.
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key

# [PUBLIC] S3-compatible endpoint for Supabase Storage.
# Format: https://[PROJECT-REF].supabase.co/storage/v1/s3
OBJECT_STORAGE_ENDPOINT=https://[PROJECT-REF].supabase.co/storage/v1/s3

# [PUBLIC] Use the region shown by Supabase's S3 connection settings.
OBJECT_STORAGE_REGION=ap-south-1

# [PUBLIC] The Supabase Storage bucket name for private uploads.
OBJECT_STORAGE_BUCKET=turbobyte-private

# [PUBLIC] Optional separate public bucket. The app proxies published media
# from the private bucket, so this can normally equal OBJECT_STORAGE_BUCKET.
OBJECT_STORAGE_PUBLIC_BUCKET=turbobyte-private


# ── Resend (transactional email) ─────────────────────────────
# [SECRET] Resend API key. Emails are skipped/queued if absent.
RESEND_API_KEY=re_...

# [PUBLIC] Notification recipient email address.
NOTIFY_EMAIL=aae@turbobytetech.com

# [PUBLIC] Sender address shown in notification emails.
NOTIFY_FROM=TurboByte Inquiries <inquiries@turbobytetechsolutions.com>

# [PUBLIC] Canonical public URL used inside email links.
PUBLIC_SITE_URL=https://turbobytetechsolutions.com


# ── Admin access ─────────────────────────────────────────────
# [PUBLIC] Comma-separated emails granted admin API access.
ADMIN_EMAILS=aae@turbobytetech.com,sourabh@turbobytetech.com

# [PUBLIC] Comma-separated full browser origins allowed for cross-origin
# API requests. Same-origin requests do not require CORS.
ALLOWED_ORIGINS=https://turbobytetechsolutions.com,https://www.turbobytetechsolutions.com


# ── Anthropic AI (optional) ──────────────────────────────────
# Required only when the AI demo feature is enabled.
# [SECRET] Direct Anthropic API key. If omitted, the API still starts, but
# the AI prototype endpoint returns an unavailable error when called.
ANTHROPIC_API_KEY=sk-ant-...

# [PUBLIC] Optional custom Anthropic-compatible endpoint. Omit to use the
# official Anthropic API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com


# ── Logging ──────────────────────────────────────────────────
# [PUBLIC] Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info


# ── Vite build (SPA only) ────────────────────────────────────
# [PUBLIC] URL base path for asset references. Defaults to "/".
BASE_PATH=/
